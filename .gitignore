# .NET build outputs (matches bin/obj at any depth under backend)
webapi/**/bin/
webapi/**/obj/

# Blazor (.NET) build outputs under frontend
frontend/blazor/bin/
frontend/blazor/obj/

# Test results / coverage
webapi/**/TestResults/
webapi/**/*.coverage
webapi/**/*.coveragexml


# APM dependencies
apm_modules/
.agents/
.github/
.codestudio/
apm*

# Design references
Design/

# -----------------------------------------------------------------------------
# Node / Vite / TypeScript (frontend apps under apps/*/frontend/apps/*)
# -----------------------------------------------------------------------------
# Build output (vendored Vite/TS bundles)
dist/
dist-ssr/
# Local dev only - never commit real secrets/API keys
*.local
.env.local
.env.*.local
# Vite / ESLint / TS caches
.vite/
.cache/
.eslintcache
*.tsbuildinfo
# Package manager lockfiles that are project-local (keep yarn.lock & package-lock.json by default — comment out if unwanted)
# Lockfile collisions across nested packages can generate noise — uncomment locally if needed.
# yarn.lock
# package-lock.json
# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Logs
logs/
*.log

# -----------------------------------------------------------------------------
# .NET backend (webapi/src/* and */tests/*)
# -----------------------------------------------------------------------------
# User-specific VS / Rider / VS Code options
*.user
*.suo
*.userosscache
*.sln.docstates
# VS Code workspace settings often reflect developer machine
.vscode/
# Rider
.idea/
*.sln.iml
# Build outputs (bin/obj already ignored above; cover other tooling artifacts)
[Bb]in/
[Oo]bj/
*.tmp
# Test results
TestResults/
[Tt]est[Rr]esult*/
# Code coverage
*.coverage
*.coveragexml
coverage/
coverage*.json
coverage*.xml
# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
# Build logs / intermediate
*.binlog
msbuild.binlog
msbuild.*.binlog
# Cake
tools/
# .NET EF Core local snapshots
*.dbmdl
*.db-shm
*.db-wal
/.vs
/webapi/.vs/HrInsights
