@*
  Port of src/components/states/EmptyState.tsx — empty-result block with
  optional action button.
*@

<div class="empty-state" style="text-align:center; padding:48px 24px;">
    <div style="margin-bottom:16px; color:#6C757D;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <line x1="9" y1="9" x2="15" y2="15" />
            <line x1="15" y1="9" x2="9" y2="15" />
        </svg>
    </div>
    <h3 style="margin-bottom:8px; color:#212529;">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p style="margin-bottom:24px; color:#6C757D;">@Description</p>
    }
    @if (!string.IsNullOrWhiteSpace(ActionLabel) && OnAction.HasDelegate)
    {
        <button class="action-btn" @onclick="OnAction">@ActionLabel</button>
    }
</div>

<style>
    .empty-state .action-btn {
        background: #3B8CDE;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }
    .empty-state .action-btn:hover { background: #2a6bb5; }
</style>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
