@*
  Port of src/components/Navigation.tsx. Syncfusion SfSidebar dockable nav with
  4 NavLinks, theme switcher, and a chevron toggle. Type=Push, dockSize=60px,
  EnableDock=true.
*@

@inject NavigationManager Nav
@inject BreakpointService Breakpoint
@implements IDisposable

@{
    // Compare against BaseRelativePath so trailing slashes and case differences
    // do not produce a stale "active" match. Strip the URL fragment (the
    // "#section" part that the Employee Experience tabs append) so switching
    // between Self-Service / Feedback / etc. does not blank the active item
    // in the sidebar. Trim a trailing slash on the current path as well so
    // "/" continues to match the Overview item.
    var rawPath = Nav.ToBaseRelativePath(Nav.Uri);
    var hashIdx = rawPath.IndexOf('#');
    if (hashIdx >= 0)
    {
        rawPath = rawPath[..hashIdx];
    }
    if (rawPath.StartsWith("?", StringComparison.Ordinal))
    {
        rawPath = rawPath[..rawPath.IndexOf('?')];
    }
    var currentPath = "/" + rawPath.TrimStart('/');
    if (currentPath.Length > 1 && currentPath[^1] == '/')
    {
        currentPath = currentPath[..^1];
    }

    // On compact viewports (xs/sm <=768px) the sidebar overlays content as
    // a hidden drawer; a FAB button expands it. On medium+ viewports it
    // behaves like the original docked push nav.
    var isCompact = Breakpoint.IsCompact;
    var sidebarType = isCompact ? SidebarType.Over : SidebarType.Push;
    var showBackdrop = isCompact;
}

<div class="app-sidebar-wrap @(_isOpen ? "" : "docked") @(_isCompact ? "compact" : null)">
    <SfSidebar @ref="sidebar"
               ID="app-sidebar"
               Width="220px"
               DockSize="65px"
               EnableDock="@(!_isCompact)"
               Type="@sidebarType"
               IsOpen="@_isOpen"
               Position="SidebarPosition.Left"
               ShowBackdrop="@showBackdrop"
               CloseOnDocumentClick="@_isCompact">
        <ChildContent>
            <div class="sidebar-header">
                @if (_isOpen)
                {
                    <span class="sidebar-title">HR Insights</span>
                }
                else
                {
                    <span class="sidebar-logo">HR</span>
                }
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                @foreach (var item in NavItems)
                {
                    var active = currentPath == item.Path;
                    <a href="@item.Path"
                       class="sidebar-nav-item @(active ? "active" : "")"
                       @onclick:preventDefault="@false">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                @((MarkupString)item.IconSvg)
                            </svg>
                        </span>
                        @if (_isOpen)
                        {
                            <span class="sidebar-label">@item.Label</span>
                        }
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                @if (_isOpen)
                {
                    <ThemeSwitcher />
                }
                <button type="button" class="sidebar-toggle" @onclick="Toggle" aria-label="Toggle sidebar">
                    @if (_isOpen)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    }
                </button>
            </div>
        </ChildContent>
    </SfSidebar>
    @if (_isCompact)
    {
        // A floating hamburger button that opens the drawer on compact
        // viewports. Always visible because the sidebar is closed by
        // default on xs/sm.
        <button type="button" class="sidebar-fab" @onclick="Toggle" aria-label="Open navigation">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
    }
</div>

@code {
    private SfSidebar? sidebar;
    private bool _isOpen = true;
    private bool _isCompact;

    private sealed record NavItem(string Id, string Label, string Path, string IconSvg);

    private static readonly NavItem[] NavItems = new[]
    {
        new NavItem("overview", "Overview", "/",
            "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/>"),
        new NavItem("workforce", "Workforce Planning", "/workforce",
            "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>"),
        new NavItem("hiring", "Hiring Pipeline", "/hiring",
            "<rect x='2' y='7' width='20' height='14' rx='2' ry='2'/><path d='M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16'/>"),
        new NavItem("experience", "Employee Experience", "/experience",
            "<path d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'/>"),
    };

    private void Toggle()
    {
        _isOpen = !_isOpen;
    }

    protected override void OnInitialized()
    {
        // Re-evaluate the active item whenever the user navigates; without
        // this, the sidebar's "active" class is frozen at the path that was
        // current when the component first rendered.
        Nav.LocationChanged += OnLocationChanged;
        Breakpoint.Changed += OnBreakpointChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize open/closed state from the current breakpoint.
            // xs/sm (compact) => closed drawer (FAB visible).
            // md (769-1024)   => docked (icons only).
            // lg/xl (>1024)   => expanded.
            _isCompact = Breakpoint.IsCompact;
            if (Breakpoint.IsCompact) _isOpen = false;
            else if (Breakpoint.IsMediumOrUp && !Breakpoint.IsLargeOrUp) _isOpen = false;
            else _isOpen = true;
        }
    }

    private void OnBreakpointChanged()
    {
        // Auto-adjust the sidebar state when the viewport crosses a
        // breakpoint boundary.
        var newCompact = Breakpoint.IsCompact;
        if (newCompact != _isCompact)
        {
            _isCompact = newCompact;
            if (newCompact) _isOpen = false;
            else if (Breakpoint.IsMediumOrUp && !Breakpoint.IsLargeOrUp) _isOpen = false;
            else _isOpen = true;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Close the drawer after navigation on compact viewports so the
        // selected page is visible without a manual close.
        if (_isCompact && _isOpen)
        {
            _isOpen = false;
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Breakpoint.Changed -= OnBreakpointChanged;
    }
}
